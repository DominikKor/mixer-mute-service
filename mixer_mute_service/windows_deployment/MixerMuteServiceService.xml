<?xml version="1.0" encoding="utf-8"?>
<service>
  <id>MixerMuteService</id>
  <name>Mixer Mute Service</name>
  <description>Safe HTTP mute groups and state tracking for the church digital mixer.</description>

  <executable>%BASE%\MixerMuteService.exe</executable>
  <workingdirectory>%BASE%</workingdirectory>

  <!-- Mutable operator data is deliberately kept outside Program Files. -->
  <env name="MIXER_CONFIG" value="%ProgramData%\MixerMuteService\config.yaml"/>
  <env name="MIXER_LOG_LEVEL" value="INFO"/>

  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>

  <onfailure action="restart" delay="5 sec"/>
  <resetfailure>1 hour</resetfailure>

  <logpath>%ProgramData%\MixerMuteService\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>

