mixer_mute_service/update-status.json
mixer_mute_service/logs/
mixer_mute_service/backups/
# Safety copies the service writes next to a data file (app/jsonstore.py,
# app/desktop_profiles.py)
*.corrupt
*.corrupt-*
*.tmp
mixer_mute_service/config.yaml.bak
# Note: config.yaml and groups.json are tracked on purpose. They are the
# templates the Windows release ships (config-template.yaml,
# groups-template.json) and the service's defaults when run from the source
# tree, which then also writes to them. Do not commit such local changes.

# Traffic captures (contain the live console state)
mixer_mute_service/captures/

# Hand-made bundles and unpacked copies
*.zip
/mixer_mute_service 2/
/MixerMuteService-src-*/
